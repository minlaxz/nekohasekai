# All seven are required. `docker compose up` refuses to start sing-box without them.
# Ports: e.g. 8895, 8896, 8897. SNI: a domain the ShadowTLS handshake imitates, e.g. mozilla.org.
# Passwords: shared by all clients (per-user auth is the Shadowsocks PSK). Generate each with
#   openssl rand -base64 32
SHADOWSOCKS_PORT=
SHADOWTLS_PORT=
HYSTERIA2_PORT=
HYSTERIA2_PASSWORD=
HYSTERIA2_OBFS_PASSWORD=
SHADOWTLS_SNI=
SHADOWTLS_PASSWORD=
# Optional. Auto-detected (IPv4) when empty.
PUBLIC_IP=

# e.g., abcdef.myaddr.tools,dev,io
APP_HOST=
APP_INTERNAL_SSM_UPSTREAM=http://sing-box:8888
APP_INTERNAL_CLIENT_DIR=/sing-box/client
APP_INTERNAL_USERS_PATH=/users.json

APP_DEFAULT_QUOTA_IN_BYTES=60000000000

# Headscale server_url. Required only for users that have a Mesh key (ts_auth_key in users.json).
APP_TS_CONTROL_URL=

# Default query parameters for client app
APP_DEFAULT_PLATFORM=a
APP_DEFAULT_VERSION=12
APP_DEFAULT_LOG_LEVEL=warn

# Default query parameters for DNS
# Any DoH host or IP without https:// prefix e.g., dns.google
# can be overridden by `dh`
APP_DEFAULT_DNS_HOST=45.90.28.0
# TLS server name when APP_DEFAULT_DNS_HOST is an IP (skips the bootstrap lookup)
# can be overridden by `dn`
APP_DEFAULT_DNS_SNI=dns.nextdns.io
# can be overridden by `dp` or /your-dns-path/
APP_DEFAULT_DNS_PATH=/
# can be overridden by `dd`
APP_DEFAULT_DNS_DETOUR=UDP
# can be overridden by `df`
APP_DEFAULT_DNS_FINAL=dns-remote
# can be overridden by `dr`
APP_DEFAULT_DNS_RESOLVER=1.1.1.1
# can be overridden by `dv`
APP_DEFAULT_DNS_VERSION=4

# Default query parameters for features
# can be overridden by `mx`
APP_DEFAULT_MULTIPLEX_ENABLED=true
