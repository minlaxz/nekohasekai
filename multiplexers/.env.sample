# headscale pre-auth key; may be blank after first join (state in ./data/tailscale)
MUX_TS_AUTH_KEY=
MUX_TS_CONTROL_URL=https://headscale.example.com
MUX_TS_HOSTNAME=mux

# One line per user: MUX_USER_<NAME>_TOKEN=<token>. Name is lowercased.
# Same token grants both ccm (Claude) and ocm (Codex).
# openssl rand -hex 24
MUX_USER_USER1_TOKEN=
MUX_USER_USER2_TOKEN=
