{
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "",
        "path": "",
        "domain_resolver": {
          "server": "dns-resolver",
          "strategy": "ipv4_only"
        },
        "detour": "Remote DNS Detour"
      },
      {
        "tag": "dns-resolver",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "shadowsocks-uot"
      },
      {
        "tag": "dns-resolver-bypass",
        "type": "udp",
        "server": "1.1.1.1"
      },
      {
        "tag": "dns-mesh",
        "type": "tailscale",
        "endpoint": "ts-ep",
        "accept_search_domain": true
      }
    ],
    "rules": [
      {
        "preferred_by": "dns-mesh",
        "action": "route",
        "server": "dns-mesh"
      },
      {
        "domain_suffix": [],
        "action": "route",
        "server": "dns-remote",
        "strategy": "prefer_ipv4"
      }
    ],
    "strategy": "ipv4_only",
    "disable_cache": false,
    "disable_expire": false,
    "cache_capacity": 10240,
    "reverse_mapping": true,
    "final": "dns-remote"
  }
}
