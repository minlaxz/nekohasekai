    "default_http_client": "proxy",
    "rules": [
      {
        "ip_cidr": ["100.64.0.0/10"],
        "outbound": "ts-ep"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "tcp",
            "port": [5222, 853]
          },
          {
            "ip_cidr": ["5.28.195.2/32", "0.0.0.0/32", "::/128"]
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        "rule_set": ["mm-ip-rules"],
        "outbound": "direct"
      },
      {
        "clash_mode": "Full",
        "outbound": "Proxy"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "rule_set": [
                  "my-rules",
                  "facebook",
                  "whatsapp",
                  "messenger",
                  "instagram",
                  "threads",
                  "notion",
                  "anthropic",
                  "viber",
                  "twitter",
                  "tailscale",
                  "stripe",
                  "slack",
                  "signal",
                  "manus",
                  "jquery",
                  "huggingface",
                  "google-gemini",
                  "docker",
                  "bluesky",
                  "figma",
                  "paypal",
                  "github",
                  "vercel",
                  "bytedance"
                ]
              },
              {
                "domain_suffix": ["gstatic.com"]
              }
            ]
          },
          {
            "clash_mode": "Partial"
          }
        ],
        "outbound": "Proxy"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-resolver"
  }
}
