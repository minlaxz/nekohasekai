{
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "shadowsocks-uot",
      "detour": "shadowtls",
      "method": "2022-blake3-aes-128-gcm",
      "password": "",
      "udp_over_tcp": {
        "enabled": true,
        "version": 2
      }
    },
    {
      "type": "shadowtls",
      "tag": "shadowtls",
      "server": "",
      "server_port": 0,
      "version": 3,
      "password": "",
      "tls": {
        "enabled": true,
        "server_name": "",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "Proxy",
      "outbounds": [
        "shadowsocks-uot"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30s",
      "tolerance": 100
    },
    {
      "type": "urltest",
      "tag": "All",
      "outbounds": [
        "direct",
        "shadowsocks-uot"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30s",
      "tolerance": 100
    },
    {
      "type": "selector",
      "tag": "Remote DNS Detour",
      "outbounds": [
        "direct",
        "Proxy"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    }
  ]
}
